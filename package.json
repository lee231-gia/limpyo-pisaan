{
  "name": "limpyo-pisaan",
  "version": "1.0.0",
  "private": true,
  "description": "Limpyo Pisaan Flutter/Dart Android app with preserved legacy web prototype",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "android:apk": "node scripts/build-flutter-apk.mjs",
    "flutter:apk": "node scripts/build-flutter-apk.mjs",
    "flutter:test": "cd flutter_app && flutter test",
    "capacitor:apk": "node scripts/build-apk.mjs",
    "capacitor:sync": "npm run build && npx cap sync android",
    "capacitor:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
